rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 0. Zero-Trust Default Deny
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Global Identity, RBAC & Validation Helpers
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRoleDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function roleData() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
    }

    function rolePermData(roleId) {
      return get(/databases/$(database)/documents/role_permissions/$(roleId)).data;
    }

    function hasRoleDefaultPerm(roleId, permKey) {
      return exists(/databases/$(database)/documents/role_permissions/$(roleId)) &&
             ('permissions' in rolePermData(roleId)) &&
             rolePermData(roleId).permissions[permKey] == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (hasRoleDoc() && roleData().roleId == 'admin' && roleData().status == 'approved') ||
        (hasUserDoc() &&
         userData().role == 'admin' &&
         (!('isSubAdmin' in userData()) || userData().isSubAdmin == false))
      );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    function isSupervisor() {
      return isSignedIn() && !isAdmin() && (
        (hasRoleDoc() &&
         roleData().roleId == 'supervisor' &&
         roleData().status == 'approved') ||
        (!hasRoleDoc() &&
         hasUserDoc() &&
         (userData().role == 'supervisor' || userData().isSubAdmin == true) &&
         userData().status == 'approved')
      );
    }

    function hasPerm(permKey) {
      return isAdmin() || (
        isSupervisor() && (
          (hasRoleDoc() && ('permissions' in roleData()) && roleData().permissions[permKey] == true) ||
          (hasRoleDoc() && !('permissions' in roleData()) && hasRoleDefaultPerm(roleData().roleId, permKey)) ||
          (!hasRoleDoc() && hasUserDoc() && ('permissions' in userData()) && userData().permissions[permKey] == true)
        )
      );
    }

    function hasLessonViewPerm() {
      return hasPerm('view_lessons') ||
        hasPerm('manage_lessons') ||
        hasPerm('view_supervisor_dashboard') ||
        hasPerm('view_absences') ||
        hasPerm('view_postponed_lessons') ||
        hasPerm('view_schedules') ||
        hasPerm('view_operational_reports');
    }

    function isApprovedTeacher() {
      return isSignedIn() && (
        (hasRoleDoc() && roleData().roleId == 'teacher' && roleData().status == 'approved') ||
        (hasUserDoc() && userData().role == 'teacher' && userData().status == 'approved')
      );
    }

    function isApprovedTeacherOrAdmin() {
      return isAdmin() || isApprovedTeacher();
    }

    // ==========================================
    // 1. Normalized RBAC Collections
    // ==========================================
    match /roles/{roleId} {
      allow get: if isSignedIn() && isValidId(roleId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(roleId);
    }

    match /permissions/{permissionKey} {
      allow get: if isSignedIn() && isValidId(permissionKey);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(permissionKey);
    }

    match /role_permissions/{roleId} {
      allow get: if isSignedIn() && isValidId(roleId);
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(roleId);
    }

    match /user_roles/{userId} {
      allow get: if isValidId(userId) && (isSelf(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        isAdmin() || (
          isSignedIn() &&
          isSelf(userId) &&
          incoming().uid == userId &&
          (incoming().roleId == 'teacher' || incoming().roleId == 'supervisor') &&
          incoming().status == 'pending' &&
          (!('permissions' in incoming()) || !incoming().permissions.values().hasAny([true]))
        )
      );
      allow update, delete: if isAdmin() && isValidId(userId);
    }

    // ==========================================
    // 2. Users Collection (/users) - PII Protected
    // ==========================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSelf(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) && (
        isAdmin() || (
          isSignedIn() &&
          isSelf(userId) &&
          (incoming().role == 'teacher' || incoming().role == 'supervisor') &&
          (incoming().status == 'pending' || !('status' in incoming())) &&
          (!('isSubAdmin' in incoming()) || incoming().isSubAdmin == false)
        )
      );

      allow update: if isValidId(userId) && (
        isAdmin() || (
          isSignedIn() &&
          isSelf(userId) &&
          (!('role' in incoming()) || incoming().role == existing().role) &&
          (!('status' in incoming()) || !('status' in existing()) || incoming().status == existing().status) &&
          (!('permissions' in incoming()) || !('permissions' in existing()) || incoming().permissions == existing().permissions) &&
          (!('isSubAdmin' in incoming()) || !('isSubAdmin' in existing()) || incoming().isSubAdmin == existing().isSubAdmin) &&
          (!('hourlyRate' in incoming()) || !('hourlyRate' in existing()) || incoming().hourlyRate == existing().hourlyRate) &&
          (!('hourlyRateIndividual' in incoming()) || !('hourlyRateIndividual' in existing()) || incoming().hourlyRateIndividual == existing().hourlyRateIndividual) &&
          (!('hourlyRateGroup' in incoming()) || !('hourlyRateGroup' in existing()) || incoming().hourlyRateGroup == existing().hourlyRateGroup) &&
          (!('monthlySalary' in incoming()) || !('monthlySalary' in existing()) || incoming().monthlySalary == existing().monthlySalary) &&
          (!('salaryType' in incoming()) || !('salaryType' in existing()) || incoming().salaryType == existing().salaryType)
        )
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // ==========================================
    // 3. Operational Non-Financial Projections
    // ==========================================
    match /studentOperationalSummaries/{studentId} {
      allow get: if isValidId(studentId) && (
        isAdmin() ||
        hasPerm('view_students') ||
        hasPerm('edit_student_operational') ||
        hasPerm('view_schedules') ||
        hasPerm('edit_schedules') ||
        hasPerm('view_supervisor_dashboard') ||
        hasPerm('view_lessons') ||
        hasPerm('manage_lessons') ||
        hasPerm('view_absences') ||
        hasPerm('view_postponed_lessons') ||
        hasPerm('view_operational_reports') ||
        hasPerm('create_requests') ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );
      allow list: if isAdmin() || isSupervisor() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);

      allow create: if isValidId(studentId) && (
        isAdmin() ||
        (isApprovedTeacher() && incoming().teacherId == request.auth.uid)
      );

      allow update: if isValidId(studentId) && (
        isAdmin() ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid) ||
        (
          hasPerm('edit_student_operational') &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'parentName', 'parentPhone', 'whatsapp', 'status', 'memorizationDirection', 'notes', 'updatedAt'
          ])
        ) ||
        (
          hasPerm('edit_schedules') &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'days', 'sessionDays', 'sessionTime', 'schedule', 'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin() && isValidId(studentId);
    }

    match /teacherOperationalProfiles/{teacherId} {
      allow get: if isValidId(teacherId) && (
        isAdmin() ||
        isSupervisor() ||
        isSelf(teacherId)
      );
      allow list: if isAdmin() || isSupervisor() || isApprovedTeacher();

      allow create: if isValidId(teacherId) && (
        isAdmin() ||
        (isSignedIn() && isSelf(teacherId))
      );

      allow update: if isValidId(teacherId) && (
        isAdmin() ||
        (isApprovedTeacher() && isSelf(teacherId))
      );

      allow delete: if isAdmin() && isValidId(teacherId);
    }

    // ==========================================
    // 4. Students Collection (/students) - Isolated from Supervisor Reads/Financial Edits
    // ==========================================
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (
        isAdmin() ||
        (isApprovedTeacher() && (
          existing().teacherId == request.auth.uid ||
          existing().requestedByTeacherId == request.auth.uid
        ))
      );

      allow list: if isAdmin() || (
        isApprovedTeacher() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.requestedByTeacherId == request.auth.uid
        )
      );

      allow create: if isValidId(studentId) && (
        isAdmin() ||
        (isApprovedTeacher() && (
          incoming().teacherId == request.auth.uid ||
          incoming().requestedByTeacherId == request.auth.uid
        ))
      );

      // Supervisors with edit_schedules may ONLY update schedule-related operational fields
      allow update: if isValidId(studentId) && (
        isAdmin() ||
        (isApprovedTeacher() && (
          existing().teacherId == request.auth.uid ||
          existing().requestedByTeacherId == request.auth.uid
        )) ||
        (
          hasPerm('edit_schedules') &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'days', 'sessionDays', 'sessionTime', 'schedule', 'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin() && isValidId(studentId);
    }

    match /studentRequests/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isValidId(requestId) && (isAdmin() || (isApprovedTeacher() && incoming().teacherId == request.auth.uid));
      allow update: if isValidId(requestId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // ==========================================
    // 5. Groups & Group Sessions
    // ==========================================
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && (
        isAdmin() ||
        hasPerm('view_schedules') ||
        hasPerm('view_lessons') ||
        hasPerm('view_supervisor_dashboard') ||
        (isApprovedTeacher() && (
          existing().teacherId == request.auth.uid ||
          existing().requestedByTeacherId == request.auth.uid
        ))
      );
      allow list: if isAdmin() || isSupervisor() || (
        isApprovedTeacher() && (
          resource.data.teacherId == request.auth.uid ||
          resource.data.requestedByTeacherId == request.auth.uid
        )
      );
      allow create: if isValidId(groupId) && (
        isAdmin() ||
        (isApprovedTeacher() && (
          incoming().teacherId == request.auth.uid ||
          incoming().requestedByTeacherId == request.auth.uid
        ))
      );
      allow update: if isValidId(groupId) && (
        isAdmin() ||
        (isApprovedTeacher() && (
          existing().teacherId == request.auth.uid ||
          existing().requestedByTeacherId == request.auth.uid
        ))
      );
      allow delete: if isAdmin() && isValidId(groupId);
    }

    match /group_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && (
        isAdmin() ||
        hasPerm('view_lessons') ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );
      allow list: if isAdmin() || isSupervisor() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isValidId(sessionId) && (
        isAdmin() ||
        hasPerm('manage_lessons') ||
        (isApprovedTeacher() && incoming().teacherId == request.auth.uid)
      );
      allow update: if isValidId(sessionId) && (
        isAdmin() ||
        hasPerm('manage_lessons') ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );
      allow delete: if isValidId(sessionId) && (
        isAdmin() ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );
    }

    match /group_requests/{requestId} {
      allow get: if isValidId(requestId) && (
        isAdmin() ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isApprovedTeacher() && resource.data.teacherId == request.auth.uid
      );
      allow create: if isValidId(requestId) && (
        isAdmin() ||
        (isApprovedTeacher() && incoming().teacherId == request.auth.uid)
      );
      allow update: if isAdmin() && isValidId(requestId);
      allow delete: if isValidId(requestId) && (
        isAdmin() ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );
    }

    // ==========================================
    // 6. Lessons & Sessions (/sessions & /lessons) - 7-Status Workflow
    // ==========================================
    match /sessions/{sessionId} {
      allow get: if isValidId(sessionId) && (
        isAdmin() ||
        hasLessonViewPerm() ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );

      allow list: if isAdmin() || hasLessonViewPerm() || (
        isApprovedTeacher() && resource.data.teacherId == request.auth.uid
      );

      allow create: if isValidId(sessionId) && (
        isAdmin() ||
        (
          (hasPerm('manage_lessons') || (hasPerm('edit_schedules') && incoming().status == 'compensatory')) &&
          incoming().teacherId is string &&
          incoming().date is string &&
          incoming().status in ['scheduled', 'completed', 'student_absent', 'teacher_absent', 'delayed', 'compensatory', 'cancelled'] &&
          (!('approved' in incoming()) || incoming().approved == false)
        ) ||
        (
          isApprovedTeacher() &&
          incoming().teacherId == request.auth.uid
        )
      );

      allow update: if isValidId(sessionId) && (
        isAdmin() ||
        (
          (hasPerm('manage_lessons') || hasPerm('edit_schedules')) &&
          (!('approved' in incoming()) || !('approved' in existing()) || incoming().approved == existing().approved)
        ) ||
        (
          isApprovedTeacher() &&
          existing().teacherId == request.auth.uid &&
          incoming().teacherId == request.auth.uid &&
          (
            existing().approved == false ||
            !('approved' in existing()) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['compensationStatus', 'compensatedBySessionId', 'compensatedAt', 'updatedAt'])
          )
        )
      );

      allow delete: if isValidId(sessionId) && (
        isAdmin() ||
        (
          isApprovedTeacher() &&
          existing().teacherId == request.auth.uid &&
          (existing().approved == false || !('approved' in existing()))
        )
      );
    }

    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && (
        isAdmin() ||
        hasLessonViewPerm() ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );

      allow list: if isAdmin() || hasLessonViewPerm() || (
        isApprovedTeacher() && resource.data.teacherId == request.auth.uid
      );

      allow create: if isValidId(lessonId) && (
        isAdmin() ||
        (
          (hasPerm('manage_lessons') || (hasPerm('edit_schedules') && incoming().status == 'compensatory')) &&
          incoming().teacherId is string &&
          incoming().date is string &&
          incoming().status in ['scheduled', 'completed', 'student_absent', 'teacher_absent', 'delayed', 'compensatory', 'cancelled'] &&
          (!('approved' in incoming()) || incoming().approved == false)
        ) ||
        (
          isApprovedTeacher() &&
          incoming().teacherId == request.auth.uid
        )
      );

      allow update: if isValidId(lessonId) && (
        isAdmin() ||
        (
          (hasPerm('manage_lessons') || hasPerm('edit_schedules')) &&
          (!('approved' in incoming()) || !('approved' in existing()) || incoming().approved == existing().approved)
        ) ||
        (
          isApprovedTeacher() &&
          existing().teacherId == request.auth.uid &&
          incoming().teacherId == request.auth.uid
        )
      );

      allow delete: if isAdmin() && isValidId(lessonId);
    }

    // ==========================================
    // 7. Immutable Operational Logs (Absence & Activity)
    // ==========================================
    match /absenceLogs/{logId} {
      allow get: if isValidId(logId) && (
        isAdmin() ||
        hasPerm('view_absences') ||
        hasPerm('view_supervisor_dashboard') ||
        hasPerm('view_lessons') ||
        hasPerm('view_operational_reports') ||
        (isApprovedTeacher() && existing().teacherId == request.auth.uid)
      );
      allow list: if isAdmin() || isSupervisor() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);

      allow create: if isValidId(logId) && (
        isAdmin() ||
        (
          (hasPerm('manage_lessons') || isApprovedTeacher()) &&
          incoming().recordedBy == request.auth.uid &&
          incoming().sessionId is string
        )
      );

      // Strictly immutable
      allow update, delete: if false;
    }

    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && (
        isAdmin() ||
        hasPerm('view_supervisor_dashboard') ||
        hasPerm('view_operational_reports') ||
        hasPerm('view_lessons')
      );
      allow list: if isAdmin() ||
        hasPerm('view_supervisor_dashboard') ||
        hasPerm('view_operational_reports') ||
        hasPerm('view_lessons');

      allow create: if isValidId(logId) && (
        isAdmin() ||
        (
          (isSupervisor() || isApprovedTeacher()) &&
          incoming().actorId == request.auth.uid &&
          incoming().actionType is string &&
          incoming().actionType.size() > 0 &&
          incoming().actionType.size() <= 80 &&
          'createdAt' in incoming()
        )
      );

      // Strictly immutable
      allow update, delete: if false;
    }

    // ==========================================
    // 8. Supervisor Requests (/supervisorRequests)
    // ==========================================
    match /supervisorRequests/{requestId} {
      allow get: if isValidId(requestId) && (
        isAdmin() ||
        (isSupervisor() && (existing().supervisorId == request.auth.uid || hasPerm('create_requests')))
      );
      allow list: if isAdmin() || (isSupervisor() && resource.data.supervisorId == request.auth.uid);

      allow create: if isValidId(requestId) && (
        isAdmin() || (
          hasPerm('create_requests') &&
          incoming().supervisorId == request.auth.uid &&
          incoming().status == 'pending' &&
          (!('adminDecision' in incoming()) || incoming().adminDecision == 'pending')
        )
      );

      allow update, delete: if isAdmin() && isValidId(requestId);
    }

    // ==========================================
    // 9. Financial Collections (Blocked from Supervisors)
    // ==========================================
    match /studentPackages/{packageId} {
      allow get: if isValidId(packageId) && isApprovedTeacherOrAdmin();
      allow list: if isApprovedTeacherOrAdmin();
      allow create, update: if isValidId(packageId) && isApprovedTeacherOrAdmin();
      allow delete: if isAdmin() && isValidId(packageId);
    }

    match /lessonCreditsLogs/{logId} {
      allow get: if isValidId(logId) && isApprovedTeacherOrAdmin();
      allow list: if isApprovedTeacherOrAdmin();
      allow create: if isValidId(logId) && isApprovedTeacherOrAdmin();
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    match /studentBalances/{studentId} {
      allow get: if isValidId(studentId) && isApprovedTeacherOrAdmin();
      allow list: if isApprovedTeacherOrAdmin();
      allow write: if isValidId(studentId) && isApprovedTeacherOrAdmin();
    }

    match /salaries/{salaryId} {
      allow read: if isAdmin() && !isSupervisor() && !isApprovedTeacher();
      allow write: if isAdmin() && !isSupervisor() && !isApprovedTeacher() && isValidId(salaryId);
    }

    match /prices/{priceId} {
      allow read: if isAdmin() && !isSupervisor() && !isApprovedTeacher();
      allow write: if isAdmin() && !isSupervisor() && !isApprovedTeacher() && isValidId(priceId);
    }

    match /balances/{balanceId} {
      allow read: if isAdmin() && !isSupervisor() && !isApprovedTeacher();
      allow write: if isAdmin() && !isSupervisor() && !isApprovedTeacher() && isValidId(balanceId);
    }

    match /studentLedger/{ledgerId} {
      allow read: if isAdmin() && !isSupervisor() && !isApprovedTeacher();
      allow write: if isAdmin() && !isSupervisor() && !isApprovedTeacher() && isValidId(ledgerId);
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() && !isSupervisor() && !isApprovedTeacher();
      allow write: if isAdmin() && !isSupervisor() && !isApprovedTeacher() && isValidId(subscriptionId);
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() && !isSupervisor() && !isApprovedTeacher();
      allow write: if isAdmin() && !isSupervisor() && !isApprovedTeacher() && isValidId(paymentId);
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin() && !isSupervisor() && !isApprovedTeacher();
      allow write: if isAdmin() && !isSupervisor() && !isApprovedTeacher() && isValidId(expenseId);
    }

    match /packages/{packageId} {
      allow read: if isApprovedTeacherOrAdmin() && !isSupervisor();
      allow write: if isAdmin() && isValidId(packageId);
    }

    match /salaryArchive/{archiveId} {
      allow get: if isValidId(archiveId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isValidId(archiveId) && (isAdmin() || (isApprovedTeacher() && incoming().teacherId == request.auth.uid));
      allow update: if isValidId(archiveId) && (
        isAdmin() || (
          isApprovedTeacher() &&
          existing().teacherId == request.auth.uid &&
          incoming().teacherId == request.auth.uid
        )
      );
      allow delete: if isAdmin() && isValidId(archiveId);
    }

    match /teacher_salary_transactions/{transId} {
      allow get: if isValidId(transId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if isAdmin() && isValidId(transId);
    }

    match /payrollReconciliationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(logId);
    }

    // ==========================================
    // 10. Notifications (Admin & Teacher Only - Blocked for Supervisors)
    // ==========================================
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isApprovedTeacherOrAdmin();
      allow list: if isApprovedTeacherOrAdmin();
      allow create: if isValidId(notificationId) && (
        isApprovedTeacherOrAdmin() || (
          isSignedIn() &&
          !isSupervisor() &&
          (incoming().recipientId == 'admin' || incoming().recipientId == request.auth.uid) &&
          (!('senderId' in incoming()) || incoming().senderId == request.auth.uid)
        )
      );
      allow update: if isValidId(notificationId) && isApprovedTeacherOrAdmin();
      allow delete: if isValidId(notificationId) && (isAdmin() || (isApprovedTeacher() && existing().senderId == request.auth.uid));
    }

    match /notification_devices/{deviceId} {
      allow get: if isValidId(deviceId) && (isAdmin() || (isApprovedTeacher() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(deviceId) && isApprovedTeacherOrAdmin() && incoming().userId == request.auth.uid;
      allow update, delete: if isValidId(deviceId) && (isAdmin() || (isApprovedTeacher() && existing().userId == request.auth.uid));
    }

    match /notification_logs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isApprovedTeacher() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(logId) && isApprovedTeacherOrAdmin();
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    match /notification_templates/{templateId} {
      allow read: if isApprovedTeacherOrAdmin();
      allow write: if isAdmin() && isValidId(templateId);
    }

    // ==========================================
    // 11. Community, Feedback, Audit, Warnings & Settings
    // ==========================================
    match /feedbacks/{feedbackId} {
      allow get: if isValidId(feedbackId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isValidId(feedbackId) && isApprovedTeacherOrAdmin();
      allow update: if isValidId(feedbackId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow delete: if isAdmin() && isValidId(feedbackId);
    }

    match /community_posts/{postId} {
      allow read: if isApprovedTeacherOrAdmin();
      allow create: if isValidId(postId) && isApprovedTeacherOrAdmin();
      allow update: if isValidId(postId) && isApprovedTeacherOrAdmin();
      allow delete: if isValidId(postId) && (isAdmin() || (isApprovedTeacher() && existing().authorId == request.auth.uid));

      match /comments/{commentId} {
        allow read: if isApprovedTeacherOrAdmin();
        allow create: if isValidId(commentId) && isApprovedTeacherOrAdmin();
        allow update: if isValidId(commentId) && (isAdmin() || (isApprovedTeacher() && existing().authorId == request.auth.uid));
        allow delete: if isValidId(commentId) && (isAdmin() || (isApprovedTeacher() && existing().authorId == request.auth.uid));
      }
    }

    match /communityFollows/{followId} {
      allow read: if isApprovedTeacherOrAdmin();
      allow create: if isValidId(followId) && isApprovedTeacherOrAdmin() && incoming().followerId == request.auth.uid && incoming().followerId != incoming().followingId;
      allow delete: if isValidId(followId) && isApprovedTeacherOrAdmin() && existing().followerId == request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidId(logId) && isSignedIn();
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    match /teacher_activity_logs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isValidId(logId) && isApprovedTeacherOrAdmin();
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    match /teacher_attendance_logs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isValidId(logId) && isApprovedTeacherOrAdmin();
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    match /teacher_mistakes/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isApprovedTeacher() && existing().teacherId == request.auth.uid));
      allow list: if isAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isValidId(logId) && isApprovedTeacherOrAdmin();
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    match /settings/{settingId} {
      allow read: if settingId == 'academy' || isSignedIn();
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /trash/{trashId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(trashId);
    }

    match /version_history/{versionId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(versionId);
    }

    match /warnings/{warningId} {
      allow read: if isAdmin();
      allow create: if isValidId(warningId) && isApprovedTeacherOrAdmin();
      allow update, delete: if isAdmin() && isValidId(warningId);
    }

    match /parentInteractions/{interactionId} {
      allow read: if isAdmin() || hasPerm('view_students');
      allow create, update: if isValidId(interactionId) && (isAdmin() || hasPerm('edit_student_operational'));
      allow delete: if isAdmin() && isValidId(interactionId);
    }
  }
}

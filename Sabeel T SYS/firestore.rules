rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 0. القاعدة العامة: المبدأ الأمني القائم على الصفر ثقة (Zero-Trust)
    // منع الوصول افتراضياً لجميع المستندات التي لم يتم السماح بها صراحة
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // الدوال المساعدة للأمان والحقق من الهوية والصلاحيات
    // ==========================================

    // دالة التحقق من أن المستخدم قام بتسجيل الدخول
    function isSignedIn() {
      return request.auth != null;
    }

    // دالة اختصار استدعاء البيانات الواردة في الطلب (incoming data)
    function incoming() {
      return request.resource.data;
    }

    // دالة اختصار استدعاء البيانات الحالية في قاعدة البيانات (existing data)
    function existing() {
      return resource.data;
    }

    // دالة التحقق من ملكية المستخدم الحالية للحساب
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // دالة جلب مستند حساب المستخدم الحالي لاستخراج الأدوار والصلاحيات
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // دالة التحقق من أن المستخدم يمتلك دور مسؤول رئيسي (Super Admin) معتمد
    function isSuperAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == 'admin' && 
             (!('isSubAdmin' in getUserData()) || getUserData().isSubAdmin == false);
    }

    // دالة التحقق من أن المستخدم يمتلك دور مسؤول (Admin) معتمد
    function isAdmin() {
      return isSuperAdmin();
    }

    // دالة التحقق من أن المستخدم مشرف إداري (Supervisor / Sub-Admin) معتمد ونشط
    function isSupervisor() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (getUserData().role == 'supervisor' || getUserData().isSubAdmin == true) && 
             getUserData().status == 'approved';
    }

    // دالة التحقق من صلاحية محددة للمشرف
    function hasSupervisorPerm(permKey) {
      return isSupervisor() && 
             ('permissions' in getUserData()) && 
             getUserData().permissions[permKey] == true;
    }

    // دالة المدير أو المشرف الإداري
    function isAdminOrSupervisor() {
      return isAdmin() || isSupervisor();
    }

    // دالة التحقق من أن المستخدم معلم معتمد ونشط بالدراسة (Approved Teacher)
    function isApprovedTeacher() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == 'teacher' && 
             getUserData().status == 'approved';
    }


    // ==========================================
    // 1. حماية مجموعة المستخدمين (/users)
    // ==========================================
    match /users/{userId} {
      // قراءة بيانات حساب فردي: صاحبه أو المدير أو المشرف
      allow get: if isSelf(userId) || isAdminOrSupervisor();
      
      // استعراض القائمة كاملة: المدير أو المشرف (للأغراض الإشرافية المعتمدة)
      allow list: if isAdminOrSupervisor();

      // إنشاء حساب جديد: يُسمح للمستخدم عند التسجيل بإنشاء حسابه كـ معلم أو مشرف بحالة "معلق pending"
      // أو المدير الذي يستطيع إضافة أي حساب
      allow create: if isAdmin() || (
        isSignedIn() && 
        isSelf(userId) && 
        (incoming().role == 'teacher' || incoming().role == 'supervisor') && 
        (incoming().status == 'pending' || !('status' in incoming()))
      );

      // التعديل: المدير يمتلك الصلاحية الكاملة. 
      // المستخدم يمتلك تعديل بياناته الشخصية وبيانات الدخول دون مساس بدوره (role) أو حالته (status) أو صلاحياته (permissions)
      allow update: if isAdmin() || (
        isSignedIn() && 
        isSelf(userId) && 
        (!('role' in incoming()) || incoming().role == existing().role) && 
        (!('status' in incoming()) || !('status' in existing()) || incoming().status == existing().status) &&
        (!('permissions' in incoming()) || !('permissions' in existing()) || incoming().permissions == existing().permissions)
      );

      // الحذف: محصور بالأدمن فقط
      allow delete: if isAdmin();
    }


    // ==========================================
    // 2. حماية مجموعة الطلاب (/students)
    // ==========================================
    match /students/{studentId} {
      // القراءة: المدير العام، أو المشرف، أو المعلم المعتمد لطلابه فقط
      allow read: if isAdmin() || 
                     (isSupervisor() && hasSupervisorPerm('viewStudents')) || 
                     (isApprovedTeacher() && (
                       existing().teacherId == request.auth.uid || 
                       existing().requestedByTeacherId == request.auth.uid
                     ));

      // الإضافة: المدير العام، أو المشرف الممنوح صلاحية الإضافة، أو المعلم
      allow create: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('addEditStudents')) || 
                      (isApprovedTeacher() && (
                        incoming().teacherId == request.auth.uid || 
                        incoming().requestedByTeacherId == request.auth.uid
                      ));

      // التعديل: المدير العام، أو المشرف الممنوح الصلاحية، أو المعلم لطلابه
      allow update: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('addEditStudents')) || 
                      (isApprovedTeacher() && (
                        existing().teacherId == request.auth.uid || 
                        existing().requestedByTeacherId == request.auth.uid
                      ));

      // الحذف: المدير العام فقط (القرارات الإدارية للمشرف تتحول إلى طلب إداري معتمد)
      allow delete: if isAdmin();
    }


    // ==========================================
    // 3. حماية مجموعة طلبات إلحاق الطلاب (/studentRequests)
    // ==========================================
    match /studentRequests/{requestId} {
      allow read: if isAdminOrSupervisor() || (isApprovedTeacher() && existing().teacherId == request.auth.uid);
      allow create: if isAdminOrSupervisor() || (isApprovedTeacher() && incoming().teacherId == request.auth.uid);
      allow update: if isAdminOrSupervisor() || (isApprovedTeacher() && existing().teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }


    // ==========================================
    // 3.1. حماية مجموعة المجموعات الجماعية (/groups)
    // ==========================================
    match /groups/{groupId} {
      allow read: if isAdmin() || 
                     (isSupervisor() && hasSupervisorPerm('manageGroups')) || 
                     (isApprovedTeacher() && (
                       existing().teacherId == request.auth.uid || 
                       existing().requestedByTeacherId == request.auth.uid
                     ));
      allow create: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('manageGroups')) || 
                      (isApprovedTeacher() && (
                        incoming().teacherId == request.auth.uid || 
                        incoming().requestedByTeacherId == request.auth.uid
                      ));
      allow update: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('manageGroups')) || 
                      (isApprovedTeacher() && (
                        existing().teacherId == request.auth.uid || 
                        existing().requestedByTeacherId == request.auth.uid
                      ));
      allow delete: if isAdmin() || (isSupervisor() && hasSupervisorPerm('manageGroups'));
    }


    // ==========================================
    // 3.2. حماية سجل حصص المجموعات الجماعية (/group_sessions)
    // ==========================================
    match /group_sessions/{sessionId} {
      allow read: if isAdmin() || 
                     (isSupervisor() && hasSupervisorPerm('manageSessions')) || 
                     (isApprovedTeacher() && existing().teacherId == request.auth.uid);
      allow create: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('manageSessions')) || 
                      (isApprovedTeacher() && incoming().teacherId == request.auth.uid);
      allow update: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('manageSessions')) || 
                      (isApprovedTeacher() && existing().teacherId == request.auth.uid);
      allow delete: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('manageSessions')) || 
                      (isApprovedTeacher() && existing().teacherId == request.auth.uid);
    }


    // ==========================================
    // 4. حماية مجموعة سجل الحصص (/sessions)
    // ==========================================
    match /sessions/{sessionId} {
      // القراءة: المدير العام، أو المشرف المعتمد، أو المعلم لحصصه فقط
      allow read: if isAdmin() || 
                     (isSupervisor() && hasSupervisorPerm('manageSessions')) || 
                     (isApprovedTeacher() && existing().teacherId == request.auth.uid);

      // الإضافة: المدير العام، أو المشرف المعتمد، أو المعلم
      allow create: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('manageSessions')) || 
                      (isApprovedTeacher() && incoming().teacherId == request.auth.uid);

      // التعديل: المدير العام، أو المشرف، أو المعلم للحصص غير المعتمدة
      allow update: if isAdmin() || 
                      (isSupervisor() && hasSupervisorPerm('manageSessions')) || 
                      (
                        isApprovedTeacher() && 
                        existing().teacherId == request.auth.uid && 
                        incoming().teacherId == request.auth.uid && 
                        (existing().approved == false || !('approved' in existing()))
                      );

      // الحذف: المدير العام، أو المعلم للحصص غير المعتمدة فقط (مشرف التشغيل ينشئ طلب حذف حصة)
      allow delete: if isAdmin() || 
                      (
                        isApprovedTeacher() && 
                        existing().teacherId == request.auth.uid && 
                        (existing().approved == false || !('approved' in existing()))
                      );
    }


    // ==========================================
    // 5. حماية مجموعة الباقات والاشتراكات ورصيد الحصص والمدفوعات
    // ==========================================
    match /studentPackages/{packageId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || isApprovedTeacher();
      allow delete: if isAdmin();
    }

    match /lessonCreditsLogs/{logId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isApprovedTeacher();
      allow update, delete: if isAdmin();
    }

    match /studentBalances/{studentId} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin() || isApprovedTeacher();
    }

    match /studentLedger/{ledgerId} {
      allow read, write: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ==========================================
    // 6. حماية مجموعة أرشيف الرواتب (/salaryArchive)
    // ==========================================
    match /salaryArchive/{archiveId} {
      // القراءة: الأدمن، أو المعلم لسجلات راتبه الخاصة فقط
      allow read: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid);

      // الإضافة: الأدمن، أو المعلم عند طلب تحويل/تأكيد الراتب الخاص به
      allow create: if isAdmin() || (isApprovedTeacher() && incoming().teacherId == request.auth.uid);

      // التعديل: الأدمن، أو المعلم لتأكيد استلام الراتب الخاص به
      allow update: if isAdmin() || (
        isApprovedTeacher() && 
        existing().teacherId == request.auth.uid && 
        incoming().teacherId == request.auth.uid
      );

      // الحذف: محصور بالأدمن
      allow delete: if isAdmin();
    }


    // ==========================================
    // 7. حماية الإشعارات والمراسلات والأجهزة والقوالب (/notifications)
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid);
    }

    match /notification_devices/{deviceId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /notification_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ==========================================
    // 7.1. حماية استطلاعات الرأي وفيدباك المعلمين (/feedbacks)
    // ==========================================
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }


    // ==========================================
    // 7.2. حماية مجتمع الأكاديمية والملتقى (/community_posts)
    // ==========================================
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isApprovedTeacher());
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (isAdmin() || isApprovedTeacher());
        allow update: if isSignedIn() && (isAdmin() || existing().authorId == request.auth.uid);
        allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
      }
    }


    // ==========================================
    // 7.3. حماية متابعات المعلمين (/communityFollows)
    // ==========================================
    match /communityFollows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().followerId == request.auth.uid && incoming().followerId != incoming().followingId;
      allow delete: if isSignedIn() && existing().followerId == request.auth.uid;
    }


    // ==========================================
    // 8. حماية سجل التدقيق والأنشطة (/auditLogs & activity logs)
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /teacher_activity_logs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /teacher_attendance_logs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /teacher_mistakes/{logId} {
      allow read: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /teacher_salary_transactions/{transId} {
      allow read: if isAdmin() || (isSignedIn() && existing().teacherId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /payrollReconciliationLogs/{logId} {
      allow read, write: if isAdmin();
    }


    // ==========================================
    // 9. حماية إعدادات الأكاديمية والمحذوفات
    // ==========================================
    match /settings/{settingId} {
      allow read: if settingId == 'academy' || isSignedIn();
      allow write: if isAdmin();
    }

    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    match /version_history/{versionId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 10. حماية مركز التحذيرات الإدارية والتشغيلية (/warnings)
    // ==========================================
    match /warnings/{warningId} {
      // قراءة التحذيرات: المدير العام أو المشرف
      allow read: if isAdminOrSupervisor();
      // إنشاء تحذير جديد (مثل تنبيه تسجيل حصة مكررة): النظام أو المعلم عند الحفظ
      allow create: if isSignedIn();
      // تحديث (تمت المراجعة): المدير العام أو المشرف
      allow update: if isAdminOrSupervisor();
      // الحذف: محصور بالمدير العام
      allow delete: if isAdmin();
    }

    // ==========================================
    // 11. حماية مركز طلبات المشرفين (/supervisorRequests)
    // ==========================================
    match /supervisorRequests/{requestId} {
      // قراءة الطلبات: المدير العام والمشرفون
      allow read: if isAdminOrSupervisor();
      // إنشاء طلب إداري جديد: المشرف بحالة معلق (pending) أو المدير
      allow create: if isAdmin() || (
        isSupervisor() && 
        incoming().supervisorId == request.auth.uid && 
        incoming().status == 'pending'
      );
      // البت في الطلب (موافقة / رفض): حصري للمدير العام فقط
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 12. حماية سجلات أولياء الأمور والشكاوى (/parentInteractions)
    // ==========================================
    match /parentInteractions/{interactionId} {
      // قراءة ومتابعة وتحديث تواصل أولياء الأمور: المدير العام ومشرفو التشغيل
      allow read, create, update: if isAdminOrSupervisor();
      allow delete: if isAdmin();
    }
  }
}

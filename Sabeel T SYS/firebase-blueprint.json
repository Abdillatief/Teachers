        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial payment transaction",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "subscriptionId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "method": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      }
    },
    "Expense": {
      "title": "Expense",
      "description": "Academy financial expense entry",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      }
    },
    "Package": {
      "title": "Package",
      "description": "Educational course or subscription package",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "sessionsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      }
    },
    "SalaryArchive": {
      "title": "SalaryArchive",
      "description": "Archived salary statement for teachers",
      "type": "object",

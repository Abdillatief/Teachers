        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["teacherId", "message"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alert or notification message for Admin and Teachers",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 2000 },
        "image": { "type": "string" },
        "type": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "targetType": { "type": "string", "enum": ["all", "teachers", "admins", "role", "specific_teachers", "specific_user"] },
        "targetIds": { "type": "array" },
        "recipientId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "targetRole": { "type": "string", "maxLength": 50 },
        "recipientRole": { "type": "string", "maxLength": 50 },
        "isPinned": { "type": "boolean" },
        "unpinnedBy": { "type": "array" },
        "senderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "scheduledAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "scheduled", "sent", "failed", "cancelled"] },
        "deepLink": { "type": "string", "maxLength": 500 },
        "readBy": { "type": "array" },
        "openedBy": { "type": "array" },
        "deletedBy": { "type": "array" }
      },
      "required": ["title", "body"]
    },
    "NotificationDevice": {
      "title": "NotificationDevice",

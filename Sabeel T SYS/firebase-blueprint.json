{
  "entities": {
    "Role": {
      "title": "Role",
      "description": "Normalized RBAC system role definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "isSystem": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Permission": {
      "title": "Permission",
      "description": "Granular RBAC permission catalog definition",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 100 },
        "group": { "type": "string", "maxLength": 64 },
        "groupLabel": { "type": "string", "maxLength": 120 },
        "label": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 400 },
        "updatedAt": { "type": "string" }
      },
      "required": ["key", "label"]
    },
    "RolePermission": {
      "title": "RolePermission",
      "description": "Default permission map associated with a system role",
      "type": "object",
      "properties": {
        "roleId": { "type": "string", "enum": ["admin", "supervisor", "teacher"] },
        "permissions": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["roleId", "permissions"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Authoritative RBAC assignment for each user (source of truth for rules and guards)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "roleId": { "type": "string", "enum": ["admin", "supervisor", "teacher"] },
        "permissions": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended", "active"] },
        "department": { "type": "string", "maxLength": 120 },
        "supervisorTitle": { "type": "string", "maxLength": 120 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "roleId", "permissions", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile for admins, supervisors, and teachers",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "supervisor", "teacher"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended", "active"] },
        "phone": { "type": "string", "maxLength": 30 },
        "department": { "type": "string", "maxLength": 120 },
        "supervisorTitle": { "type": "string", "maxLength": 120 },
        "bio": { "type": "string", "maxLength": 500 },
        "permissions": { "type": "object" },
        "paymentChannels": { "type": "object" },
        "hourlyRate": { "type": "number" },
        "monthlySalary": { "type": "number" },
        "salaryType": { "type": "string", "maxLength": 40 },
        "communityDisplayName": { "type": "string", "maxLength": 100 },
        "communityTitle": { "type": "string", "maxLength": 150 },
        "communityPhotoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Full student record managed by admins and teachers (isolated from supervisors)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "parentPhone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "waWarningCount": { "type": "number" },
        "lastWaWarningAt": { "type": "string" },
        "teacherId": { "type": "string", "maxLength": 128 },
        "requestedByTeacherId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 100 },
        "schedule": { "type": "object" },
        "days": { "type": "array" },
        "sessionDays": { "type": "array" },
        "sessionTime": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "StudentOperationalSummary": {
      "title": "StudentOperationalSummary",
      "description": "Non-financial operational projection of student data accessible to authorized supervisors",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "age": { "type": "string", "maxLength": 30 },
        "gender": { "type": "string", "maxLength": 20 },
        "parentName": { "type": "string", "maxLength": 120 },
        "parentPhone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "country": { "type": "string", "maxLength": 80 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "maxLength": 40 },
        "packageName": { "type": "string", "maxLength": 120 },
        "sessionDuration": { "type": "number" },
        "totalLessons": { "type": "number" },
        "usedLessons": { "type": "number" },
        "remainingLessons": { "type": "number" },
        "remainingSessions": { "type": "number" },
        "subscriptionType": { "type": "string", "maxLength": 30 },
        "groupId": { "type": "string", "maxLength": 128 },
        "groupName": { "type": "string", "maxLength": 120 },
        "days": { "type": "array" },
        "sessionTime": { "type": "string", "maxLength": 40 },
        "schedule": { "type": "object" },
        "memorizationDirection": { "type": "string", "enum": ["ascending", "descending"] },
        "lastMemorizedSurahId": { "type": "number" },
        "lastMemorizedSurahName": { "type": "string", "maxLength": 60 },
        "lastMemorizedVerse": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "name"]
    },
    "TeacherOperationalProfile": {
      "title": "TeacherOperationalProfile",
      "description": "Non-financial operational profile and working schedule for teachers",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "maxLength": 40 },
        "dailyWorkHours": { "type": "number" },
        "workWindowHours": { "type": "string", "maxLength": 100 },
        "weeklySchedule": { "type": "object" },
        "notes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name"]
    },
    "Session": {
      "title": "Session",
      "description": "Educational lesson/session record supporting 7 operational statuses and compensation linking",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 30 },
        "duration": { "type": "number" },
        "type": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["scheduled", "completed", "student_absent", "teacher_absent", "delayed", "compensatory", "cancelled"] },
        "absenceType": { "type": "string", "maxLength": 30 },
        "absenceReason": { "type": "string", "maxLength": 500 },
        "postponedFrom": { "type": "string", "maxLength": 20 },
        "postponeReason": { "type": "string", "maxLength": 500 },
        "responsibleParty": { "type": "string", "maxLength": 40 },
        "makeupDate": { "type": "string", "maxLength": 20 },
        "makeupTime": { "type": "string", "maxLength": 30 },
        "teacherNotes": { "type": "string", "maxLength": 1000 },
        "slotSelectionReason": { "type": "string", "maxLength": 500 },
        "compensationStatus": { "type": "string", "enum": ["pending", "scheduled", "completed"] },
        "originalLessonId": { "type": "string", "maxLength": 128 },
        "compensatedBySessionId": { "type": "string", "maxLength": 128 },
        "cancellationResponsibility": { "type": "string", "maxLength": 40 },
        "cancellationReason": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 1500 },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["teacherId", "studentId", "date", "status"]
    },
    "AbsenceLog": {
      "title": "AbsenceLog",
      "description": "Immutable log of student and teacher absences",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "absenceSubject": { "type": "string", "enum": ["student", "teacher"] },
        "absenceType": { "type": "string", "enum": ["excused", "unexcused", "teacher_absence"] },
        "reason": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 30 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "recordedByName": { "type": "string", "maxLength": 120 },
        "recordedByRole": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["sessionId", "teacherId", "absenceSubject", "date", "recordedBy"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable operational audit log capturing who modified what, when, and why",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 30 },
        "actionType": { "type": "string", "maxLength": 80 },
        "targetCollection": { "type": "string", "maxLength": 80 },
        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 500 },
        "oldValue": { "type": "object" },
        "newValue": { "type": "object" },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["actorId", "actionType", "targetCollection"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Student package subscription",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "packageId": { "type": "string", "maxLength": 128 },

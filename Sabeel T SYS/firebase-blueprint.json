        "referenceId": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["studentId", "type", "amount"]
    },
    "PayrollReconciliationLog": {
      "title": "PayrollReconciliationLog",
      "description": "Audit record of payroll and session reconciliation verification",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "month": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["balanced", "acceptable_discrepancy", "critical_discrepancy"] },
        "calculatedSalary": { "type": "number" },
        "targetSalary": { "type": "number" },
        "discrepancyAmount": { "type": "number" },
        "totalSessions": { "type": "number" },
        "includedSessions": { "type": "number" },
        "excludedSessions": { "type": "number" },
        "adminName": { "type": "string", "maxLength": 100 },
        "adminId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["teacherId", "month", "status"]
    },
    "Warning": {
      "title": "Warning",
      "description": "System warning alerts such as duplicate session recording alerts",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["duplicate_session", "unrecorded_session", "unusual_credit_activity"] },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "firstRecordedAt": { "type": "string", "maxLength": 50 },
        "secondRecordedAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["unreviewed", "reviewed"] },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "status"]
    },
    "SupervisorRequest": {
      "title": "SupervisorRequest",
      "description": "Operational change and administrative action requests submitted by Supervisors to the Admin",
      "type": "object",
      "properties": {
        "supervisorId": { "type": "string", "maxLength": 128 },
        "supervisorName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 64 },
        "typeLabel": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 2000 },
        "reason": { "type": "string", "maxLength": 2000 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetName": { "type": "string", "maxLength": 120 },
        "payload": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminDecision": { "type": "string", "enum": ["pending", "kept_pending", "approved", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 2000 },
        "adminResponse": { "type": "string", "maxLength": 2000 },
        "reviewedBy": { "type": "string", "maxLength": 150 },
        "reviewedByName": { "type": "string", "maxLength": 120 },
        "reviewedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["supervisorId", "type", "title", "status"]
    },
    "ParentInteraction": {
      "title": "ParentInteraction",
      "description": "Parent communication, complaints, inquiries, and follow-ups",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "parentName": { "type": "string", "maxLength": 100 },
        "parentPhone": { "type": "string", "maxLength": 30 },
        "supervisorId": { "type": "string", "maxLength": 128 },
        "supervisorName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["inquiry", "complaint", "renewal_followup", "performance_note", "general"] },
        "channel": { "type": "string", "enum": ["whatsapp", "phone_call", "in_person"] },
        "status": { "type": "string", "enum": ["open", "resolved", "pending_parent"] },
        "subject": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 3000 },
        "actionTaken": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentName", "type", "subject", "details", "status"]
    }
  },

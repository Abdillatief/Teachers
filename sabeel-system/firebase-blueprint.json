{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for admins and teachers",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "teacher"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "active"] },
        "phone": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 500 },
        "permissions": { "type": "object" },
        "paymentChannels": { "type": "object" },
        "hourlyRate": { "type": "number" },
        "monthlySalary": { "type": "number" },
        "salaryType": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record managed by admins or teachers",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "parentPhone": { "type": "string", "maxLength": 30 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "requestedByTeacherId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "Session": {
      "title": "Session",
      "description": "Educational session record",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "duration": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "absent", "delayed", "postponed", "cancelled"] },
        "notes": { "type": "string", "maxLength": 500 },
        "approved": { "type": "boolean" },
        "cost": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["teacherId", "studentId", "date"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Student package subscription",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "packageId": { "type": "string", "maxLength": 128 },
        "price": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial payment transaction",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "subscriptionId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "method": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      }
    },
    "Package": {
      "title": "Package",
      "description": "Educational course or subscription package",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "sessionsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      }
    },
    "SalaryArchive": {
      "title": "SalaryArchive",
      "description": "Archived salary statement for teachers",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "month": { "type": "string", "maxLength": 20 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "confirmed"] },
        "details": { "type": "object" },
        "createdAt": { "type": "string" },
        "confirmedAt": { "type": "string" }
      },
      "required": ["teacherId", "month", "amount"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alert or notification message",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "body": { "type": "string", "maxLength": 1000 },
        "read": { "type": "boolean" },
        "type": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["recipientId", "title"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail log of actions taken in the academy",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string" }
      }
    },
    "Setting": {
      "title": "Setting",
      "description": "Academy setting or configuration document",
      "type": "object",
      "properties": {
        "academyName": { "type": "string", "maxLength": 100 },
        "currency": { "type": "string", "maxLength": 10 },
        "rules": { "type": "object" }
      }
    },
    "TrashItem": {
      "title": "TrashItem",
      "description": "Soft deleted or trash item",
      "type": "object",
      "properties": {
        "originalCollection": { "type": "string", "maxLength": 50 },
        "originalId": { "type": "string", "maxLength": 128 },
        "data": { "type": "object" },
        "deletedAt": { "type": "string" }
      }
    },
    "Group": {
      "title": "Group",
      "description": "Group session class record",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "students": { "type": "array" },
        "sessionDays": { "type": "array" },
        "sessionTime": { "type": "string" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string" }
      }
    },
    "GroupSession": {
      "title": "GroupSession",
      "description": "Recorded session for group attendance",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "maxLength": 128 },
        "groupName": { "type": "string", "maxLength": 100 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string" },
        "duration": { "type": "number" },
        "studentsAttendance": { "type": "object" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile data for admins and teachers"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student records and enrollment info"
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Group class records and rosters"
    },
    "/group_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/GroupSession" },
      "description": "Attendance logs for group sessions"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Class session attendance and records"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Student package subscriptions"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Financial payment receipts"
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/Package" },
      "description": "Available educational packages"
    },
    "/salaryArchive/{archiveId}": {
      "schema": { "$ref": "#/entities/SalaryArchive" },
      "description": "Monthly salary payout logs and history"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System alerts and notifications"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit trail for system actions"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Global system configurations"
    },
    "/trash/{trashId}": {
      "schema": { "$ref": "#/entities/TrashItem" },
      "description": "Archived or soft-deleted items"
    }
  }
}
